    },
    {
      "text": "I know, I know\n",
      "start": 17.6,
      "end": 17.84
    },
    {
      "text": "Three in the morning, I'm losing my mind\n",
      "start": 37.44,
      "end": 40.32
    },
    {
      "text": "Your silhouette dancing in the back of my eyes\n",
      "start": 41.6,
      "end": 44.88
    },
    {
      "text": "I got a new girl, but she don't feel right\n",
      "start": 45.68,
      "end": 48.8
    },
    {
      "text": "I'm chasing your ghost through the city tonight\n",
      "start": 49.28,
      "end": 51.84
    },
    {
      "text": "Red lights flashing on an empty street\n",
      "start": 53.92,
      "end": 57.2
    },
    {
      "text": "Got your perfume still haunting my sheets\n",
      "start": 58.0,
      "end": 61.36
    },
    {
      "text": "I tell myself that I'm better alone\n",
      "start": 62.16,
      "end": 65.2
    },
    {
      "text": "But I keep checking every time you call my phone\n",
      "start": 65.2,
      "end": 69.28
    },
    {
      "text": "And I know we crossed the line\n",
      "start": 69.4,
      "end": 71.24
    },
    {
      "text": "But I still want you tonight\n",
      "start": 71.64,
      "end": 73.24
    },
    {
      "text": "Every time I close my eyes\n",
      "start": 73.72,
      "end": 75.72
    },
    {
      "text": "You're the only thing I find\n",
      "start": 75.72,
      "end": 77.4
    },
    {
      "text": "After midnight\n",
      "start": 78.02,
      "end": 78.26
    },
    {
      "text": "I keep falling for your lies\n",
      "start": 79.14,
      "end": 81.38
    },
    {
      "text": "Under red lights\n",
      "start": 81.8,
      "end": 82.92
    },
    {
