  "words": [
    {
      "text": "I've been sleeping with the lights on\n",
      "start": 14.98,
      "end": 18.08
    },
    {
      "text": "Waiting for the fear to fade\n",
      "start": 19.28,
      "end": 21.88
    },
    {
      "text": "Every road I took was dead wrong\n",
      "start": 23.58,
      "end": 26.56
    },
    {
      "text": "Every promise came too late\n",
      "start": 27.8,
      "end": 30.58
    },
    {
      "text": "I've got nothing left to lose\n",
      "start": 31.88,
      "end": 34.62
    },
    {
      "text": "Nothing left to prove\n",
      "start": 34.62,
      "end": 36.5
    },
    {
      "text": "Let the whole world fall apart\n",
      "start": 36.5,
      "end": 38.54
    },
    {
      "text": "I'll find another way to move\n",
      "start": 38.54,
      "end": 40.76
    },
    {
      "text": "I've got nothing left to hide\n",
      "start": 40.76,
      "end": 42.98
    },
    {
      "text": "I'm still breathing, still alive\n",
      "start": 42.98,
      "end": 45.02
    },
    {
      "text": "If the sky comes crashing down\n",
      "start": 45.02,
      "end": 47.56
    },
    {
      "text": "I'll be standing on the other side\n",
      "start": 48.9,
      "end": 52.04
    },
    {
      "text": "On the other side\n",
      "start": 57.8,
      "end": 60.86
    },
    {
      "text": "There's a freedom in the silence\n",
      "start": 67.38,
      "end": 72.04
    },
    {
      "text": "There's a beauty in the scars\n",
      "start": 72.04,
      "end": 75.86
    },
    {
      "text": "I don't need another reason\n",
      "start": 75.86,
      "end": 80.44
    },
    {
      "text": "To remember who we are\n",
      "start": 80.44,
      "end": 84.22
    },
    {
      "text": "I've got nothing left to lose\n",
      "start": 84.22,
      "end": 86.36
