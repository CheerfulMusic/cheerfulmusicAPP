  "recognition": "Qwen3-ForcedAligner-0.6B",
  "duration": 152.67997916666667,
  "warnings": [],
  "words": [
    {
      "text": "乱世围城  入夜繁华 旧\n",
      "start": 2.08,
      "end": 5.28
    },
    {
      "text": "舞榭歌台 一曲光景  留\n",
      "start": 8.48,
      "end": 12.16
    },
    {
      "text": "江湖之上 暮云泛舟  秋风载远游\n",
      "start": 14.8,
      "end": 19.68
    },
    {
      "text": "挥剑天涯  我邀岁月酌酒\n",
      "start": 21.12,
      "end": 24.4
    },
    {
      "text": "走单骑  着铁衣\n",
      "start": 27.76,
      "end": 29.04
    },
    {
      "text": "斩敌寇  千里袭\n",
      "start": 29.04,
      "end": 30.48
    },
    {
      "text": "满面风霜堆积\n",
      "start": 30.64,
      "end": 32.56
    },
    {
      "text": "酒已酣  乡愁起\n",
      "start": 34.16,
      "end": 35.36
    },
    {
      "text": "望秋水  雁折翼\n",
      "start": 35.36,
      "end": 36.88
    },
    {
      "text": "身似浮萍万里\n",
      "start": 36.88,
      "end": 40.08
    },
    {
      "text": "此去归途恐无期\n",
      "start": 40.08,
      "end": 41.84
    },
    {
      "text": "听 西风撞 烈马追\n",
      "start": 44.14,
      "end": 46.38
    },
    {
      "text": "凭孤胆 洒热血\n",
      "start": 46.46,
      "end": 47.98
    },
    {
      "text": "梦荡气回肠\n",
      "start": 48.06,
      "end": 50.46
    },
    {
      "text": "生死何妨\n",
      "start": 51.5,
      "end": 51.82
    },
    {
      "text": "破城关  惊弓响\n",
      "start": 52.06,
      "end": 53.42
    },
    {
      "text": "百步穿杨\n",
      "start": 53.58,
      "end": 54.22
    },
    {
      "text": "看 烽火连 遍狼烟\n",
      "start": 57.5,
      "end": 58.94
    },
    {
      "text": "战鼓唱 杀气扬\n",
      "start": 58.9,
      "end": 60.26
    },
    {
      "text": "千军我独闯\n",
      "start": 61.2,
      "end": 62.32
    },
    {
      "text": "名垂四海\n",
      "start": 63.82,
      "end": 64.7
    },
    {
      "text": "舍身在八荒\n",
      "start": 65.92,
      "end": 67.12
    },
    {
      "text": "走单骑  着铁衣\n",
      "start": 95.48,
