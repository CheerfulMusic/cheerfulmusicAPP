{
  "sourceKey": "sample:meng-de-chi-bang:db6bbbc7-5542-3497-a459-95087068bf2e",
  "audioSha256": "604cf455628c7af1335b95fd15f86e01287acc9354069b0c33994e9c5c14c502",
  "recognition": "Qwen3-ForcedAligner-0.6B",
  "duration": 154.08,
  "warnings": [],
  "words": [
    {
      "text": "隐隐坠下季节的落叶，\n",
      "start": 29.44,
      "end": 33.28
    },
    {
      "text": "阵阵秋风吹得好凄凉，\n",
      "start": 34.88,
      "end": 38.72
    },
    {
      "text": "我的忧伤飘散在远方，\n",
      "start": 41.04,
      "end": 45.52
    },
    {
      "text": "没有你我感觉好孤单。\n",
      "start": 47.52,
      "end": 51.44
    },
    {
      "text": "思念已经化成了眼泪，\n",
      "start": 52.0,
      "end": 60.08
    },
    {
      "text": "一滴一滴刺痛我的心，\n",
      "start": 60.96,
      "end": 63.36
    },
    {
      "text": "梦的翅膀已经受了伤，\n",
      "start": 66.72,
      "end": 71.28
    },
    {
      "text": "我飞不到有你的地方。\n",
      "start": 72.8,
      "end": 76.0
    },
    {
      "text": "每次想你我都会心痛，\n",
      "start": 79.44,
      "end": 83.68
    },
    {
      "text": "我的思念转过寂静的天空，\n",
      "start": 83.76,
      "end": 88.32
    },
    {
      "text": "我的记忆里有你的痕迹，\n",
      "start": 92.4,
      "end": 96.8
    },
    {
      "text": "我的爱在寂寞世界里。\n",
      "start": 97.92,
      "end": 102.48
    },
    {
      "text": "天空飘过流浪的白云，\n",
      "start": 103.0,
      "end": 108.92
    },
    {
      "text": "就像我们已经破碎的爱情，\n",
      "start": 111.24,
      "end": 115.64
    },
    {
      "text": "爱得太累心已憔悴，\n",
      "start": 116.68,
      "end": 121.0
    },
    {
      "text": "让风吹干受伤的眼泪。\n",
      "start": 122.76,
      "end": 125.32
    }
  ]
}
