# 复制为同目录 local.properties 后填写。该文件由 mysql profile 导入。
# Google登录仅在服务端私有配置启用，禁止把secret放入VITE_变量。
# qingfeng.auth.google.enabled=true
# qingfeng.auth.google.client-id=
# qingfeng.auth.google.client-secret=
# qingfeng.auth.google.redirect-uri=http://127.0.0.1:8081/api/public/auth/google/callback
# qingfeng.auth.logto.enabled=true
# qingfeng.auth.logto.issuer=http://localhost:3001/oidc
# qingfeng.auth.logto.client-id=
# qingfeng.auth.logto.client-secret=
# qingfeng.auth.logto.redirect-uri=http://127.0.0.1:5173/api/public/auth/logto/callback
# 邮件、短信连接器完成真实发送测试后，再分别将开关设为 true。
# qingfeng.auth.logto.email-enabled=false
# qingfeng.auth.logto.phone-enabled=false
# 仅在国际短信渠道配置并验证后开启；阿里云 MAS 仅支持中国大陆 +86。
# qingfeng.auth.logto.phone-international-enabled=false
# Apple 连接器完成登录测试后，填写其 Logto IdP 名称（通常为 apple），不是连接器 UUID。
# qingfeng.auth.logto.apple-idp-name=
# 先在本地 MySQL 创建独立数据库 qingfeng_music，禁止指向其他业务库。
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/qingfeng_music?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
spring.datasource.username=
spring.datasource.password=
# 真实API账号注册并确定额度后填写，不发送到聊天中。
qingfeng.providers.mureka.api-key=
# 火山引擎Key只放实际私有配置；需先确认是歌曲服务还是Seed Audio音频服务。
# 填入Key不会自动启用生成。
qingfeng.providers.volcengine.api-key=
# KIE Suno，统一任务API；密钥仅填入实际local.properties或KIE_API_KEY环境变量。
qingfeng.providers.kie.api-key=
qingfeng.providers.kie.model=V6
# 风格遵循0~1、创意偏移0~1、多样性0~4。初始调优值，非听感保证。
qingfeng.providers.kie.style-weight=0.85
qingfeng.providers.kie.weirdness-constraint=0.25
qingfeng.providers.kie.variety=0
# 局部改词参考原曲的权重0~1；不保证修改片段旋律、音色完全一致。
qingfeng.providers.kie.section-audio-weight=0.85
qingfeng.providers.deepseek.api-key=
qingfeng.providers.deepseek.model=deepseek-flash
# 写词提供方：openai 使用 GPT；deepseek 保留原模型。AI灵感改写独立配置。
qingfeng.lyrics.provider=openai
qingfeng.providers.openai.api-key=
qingfeng.providers.openai.model=gpt-6.1-terra
# 可用环境变量 OPENAI_API_KEY 提供密钥；禁止提交真实值。
qingfeng.lyrics.enabled=false
qingfeng.generation.provider=unconfigured

# 示例默认暂停真实音乐执行。KIE在认证查询中登记精确音频URL，固定CDN域名为可选。
qingfeng.generation.enabled=false
qingfeng.generation.section-editing-enabled=true
qingfeng.generation.audio-hosts=
# 本地归档与每位创建者容量（字节，默认1GB）。
qingfeng.media.storage=local
qingfeng.media.directory=./data/audio
qingfeng.media.creator-capacity-bytes=1073741824
# OSS可选：先填写RAM用户配置；storage切到oss后新上传才写云端，旧本地文件仍可读。
# endpoint示例：https://oss-cn-hangzhou.aliyuncs.com
# qingfeng.oss.endpoint=
# qingfeng.oss.region=
# qingfeng.oss.bucket=
# qingfeng.oss.prefix=qingfeng/audio/
# qingfeng.oss.access-key-id=
# qingfeng.oss.access-key-secret=

# 创作额度统一在 config/usage-limits.properties 配置：-1不限，0禁止新增，正整数限额。
# 已准入请求失败不自动退额；同一请求重放、进度查询和归档重试不重复占额。

# 积分与支付后端默认关闭。Airwallex 与 PayPal 均只支持沙箱联调，不支持生产收款。
# 使用独立测试数据库和沙箱账号，在本机私有 local.properties 中按需填写，勿提交真实凭证。
qingfeng.credits.enabled=false
qingfeng.credits.music-cost=10
qingfeng.payments.enabled=false
# qingfeng.payments.client-id=
# qingfeng.payments.api-key=
# qingfeng.payments.account-id=
# qingfeng.payments.webhook-secret=
# PayPal 沙箱；密钥只写入本机私有配置。正式环境目前被禁用。
qingfeng.paypal.enabled=false
qingfeng.paypal.environment=sandbox
# qingfeng.paypal.client-id=
# qingfeng.paypal.client-secret=
# qingfeng.paypal.merchant-id=
# qingfeng.paypal.webhook-id=
# 套餐价格由服务端配置，客户端只能选择对应套餐 ID，不可指定金额。
# qingfeng.payments.prices.usd.starter=4.99
# qingfeng.payments.prices.usd.standard=12.99
# qingfeng.payments.prices.usd.plus=24.99

# 播放歌词时间轴。compatible 为当前已验证的官方兼容接口；unified 为统一接口。
# 默认只读取缓存；未同步的歌曲由用户点击同步。结果未知不自动重试、不重新生成歌曲。
qingfeng.lyrics.timing.enabled=true
qingfeng.providers.kie.lyrics-timing-mode=compatible

# 自定义封面。AI加工使用google/nano-banana-edit，复用KIE密钥或配置独立图片密钥。
qingfeng.cover.directory=./data/covers
qingfeng.cover.ai.enabled=true
qingfeng.cover.ai.scheduler-enabled=true
# qingfeng.providers.kie.image-api-key=
