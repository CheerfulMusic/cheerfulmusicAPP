# Private server configuration only. Keep enabled=false until both routes and the Logto HTTP connector are ready.
# Logto HTTP SMS connector: endpoint=https://cheerfulmusic.com/api/public/auth/sms/deliver
# authorization must contain the complete "Bearer <secret>" value. Use 32+ random bytes encoded as base64url (43+ chars).
# Native connector request: {"to":"447700900123","type":"SignIn","payload":{"code":"123456"}}
qingfeng.auth.sms-bridge.enabled=false
qingfeng.auth.sms-bridge.bearer-secret=
qingfeng.auth.sms-bridge.hourly-limit=200

# International / Hong Kong, Macao and Taiwan: SendMessageToGlobe 2018-05-01, Singapore endpoint, fixed OTP text.
qingfeng.auth.sms-bridge.international.enabled=false
qingfeng.auth.sms-bridge.international.access-key-id=
qingfeng.auth.sms-bridge.international.access-key-secret=
qingfeng.auth.sms-bridge.international.sender-id=Cheerful
# Optional numeric ChannelId; a console display name is not a ChannelId. Leave blank unless confirmed.
qingfeng.auth.sms-bridge.international.channel-id=

# Mainland: retain the existing Aliyun MAS sign/template and deliver the exact code generated by Logto.
qingfeng.auth.sms-bridge.cn.enabled=false
qingfeng.auth.sms-bridge.cn.access-key-id=
qingfeng.auth.sms-bridge.cn.access-key-secret=
qingfeng.auth.sms-bridge.cn.sign-name=
qingfeng.auth.sms-bridge.cn.template-code=
