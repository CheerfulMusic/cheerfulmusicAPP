# Reviewed settings example only; do not copy over an existing private configuration.
# API and worker instances share the SAME approved main DB in real use.
# Tests use a completely isolated DB and sandbox credentials.
qingfeng.payment.inbox.scheduler-enabled=true
qingfeng.payment.inbox.worker-concurrency=4
qingfeng.payment.inbox.scan-ms=1000
qingfeng.payment.reconcile.scan-ms=60000
# Budget total connections across ALL API/worker instances against MySQL capacity.
# Example pool capacity, not a production sizing guarantee:
spring.datasource.hikari.maximum-pool-size=16
# Preserve any existing init SQL; merge these assignments rather than overwriting it.
spring.datasource.hikari.connection-init-sql=SET SESSION time_zone='+00:00', innodb_lock_wait_timeout=5
# Financial writer protocol, authoritative verification and startup DB integrity checks stay enabled.
# No automatic migrations, production changes, live keys or real funds are configured here.

# Default ingress remains 600/minute/provider. Example ONLY for a reviewed 100 TPS target:
# include duplicate deliveries and retries when sizing. Shared Redis buckets apply cluster-wide;
# local buckets apply per API instance. This is an ingress budget, not measured sustainable TPS.
qingfeng.payment.webhook.rate-limit-per-minute=12000
