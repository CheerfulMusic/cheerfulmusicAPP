[Unit]
Description=Qingfeng Singapore replica freshness proof
After=qingfeng-sg-mysql-replica.service

[Service]
Type=simple
RuntimeDirectory=qingfeng-sg-replica-proof
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3.11 /opt/qingfeng-regional/sg-replica-proof.py --mysql-defaults /srv/qingfeng-data/sg-read-replica/admin.cnf --proof /run/qingfeng-sg-replica-proof/ready
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
