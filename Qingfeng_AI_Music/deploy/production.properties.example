# Merge with the existing private provider configuration on the server.
# Quotas are configured only in /etc/qingfeng-music/usage-limits.properties.
# Copy config/usage-limits.properties there; -1 = unlimited, 0 = disabled.
# Replace database credentials with a dedicated local MySQL account.
server.address=127.0.0.1
server.port=8080
server.forward-headers-strategy=framework
# Fill only in /etc/qingfeng-music/application.properties; never commit actual credentials.
# qingfeng.auth.google.enabled=true
# qingfeng.auth.google.client-id=
# qingfeng.auth.google.client-secret=
# qingfeng.auth.google.redirect-uri=https://cheerfulmusic.com/api/public/auth/google/callback
# qingfeng.auth.logto.enabled=true
# qingfeng.auth.logto.issuer=https://auth.cheerfulmusic.com/oidc
# qingfeng.auth.logto.client-id=
# qingfeng.auth.logto.client-secret=
# qingfeng.auth.logto.redirect-uri=https://cheerfulmusic.com/api/public/auth/logto/callback
# Enable only after each Logto delivery connector sends and verifies a real code.
# qingfeng.auth.logto.email-enabled=false
# qingfeng.auth.logto.phone-enabled=false
# Enable only after an international SMS connector has been configured and verified.
# Aliyun MAS supports mainland China (+86) only; leave false for that connector.
# qingfeng.auth.logto.phone-international-enabled=false
# Set this to the tested Apple social connector IdP name (usually apple), not its UUID.
# qingfeng.auth.logto.apple-idp-name=
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/qingfeng_music?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
spring.datasource.username=qingfeng
spring.datasource.password=REPLACE_ON_SERVER
qingfeng.media.storage=local
qingfeng.media.directory=/var/lib/qingfeng-music/audio

# 自定义封面独立存储，必须放在systemd允许写入并已备份的目录。
qingfeng.cover.directory=/var/lib/qingfeng-music/covers

# CDN 签名 URL 分发（默认关闭；仅在服务器私有配置中填写真实值，禁止提交密钥）。
# 启用前须完成：私有 Bucket 回源授权、Range 回源、URL 鉴权方式 A、独立子域、日志脱敏。
# qingfeng.cdn.enabled=false
# qingfeng.cdn.domain=https://cdn.example.com
# qingfeng.cdn.key-primary=
# qingfeng.cdn.key-backup=
# qingfeng.cdn.ttl-seconds=600
# qingfeng.cdn.uid=0
# 与存储侧保持一致；音频对象名不含 prefix，封面对象名已含 cover-prefix。
# qingfeng.oss.prefix=qingfeng/audio/
# qingfeng.oss.cover-prefix=qingfeng/covers/
