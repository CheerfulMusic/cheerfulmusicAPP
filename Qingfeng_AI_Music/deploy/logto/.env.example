# Copy to .env in this directory. .env is ignored by Git.
# Use a long, random URL-safe value (letters and digits) because the same value
# is interpolated into both POSTGRES_PASSWORD and the PostgreSQL connection URL.
LOGTO_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
# Generate a separate, random 32-byte key encoded as Base64. Keep it stable
# across restarts; replacing it makes encrypted Logto secrets unreadable.
LOGTO_SECRET_VAULT_KEK=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Local development. For production, use two HTTPS domains with valid DNS/TLS.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
LOGTO_TRUST_PROXY_HEADER=0
